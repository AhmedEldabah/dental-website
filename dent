    <div class="modal-overlay" id="bookingModal">
        <div class="modal-content">
            <i class="fas fa-times close-modal" onclick="closeModal()"></i>
            <div class="modal-header">
                <h3>Book Your Visit</h3>
                <p>Fill out the details below to request an appointment via WhatsApp.</p>
            </div>
            
            <div class="form-group">
                <label for="pat-name">Full Name</label>
                <input type="text" id="pat-name" placeholder="E.g., Sarah Ahmed">
            </div>
            
            <div class="form-group">
                <label for="pat-service">Service Needed</label>
                <select id="pat-service">
                    <option value="" disabled selected>Select a treatment...</option>
                    <option value="General Checkup & Cleaning">General Checkup & Cleaning</option>
                    <option value="Smile Design / Veneers">Smile Design / Veneers</option>
                    <option value="Laser Teeth Whitening">Laser Teeth Whitening</option>
                    <option value="Invisalign / Orthodontics">Invisalign / Orthodontics</option>
                    <option value="Dental Implants">Dental Implants</option>
                    <option value="Root Canal / Pain Relief">Root Canal / Pain Relief</option>
                    <option value="Other Consultation">Other Consultation</option>
                </select>
            </div>
            
            <div class="form-group">
                <label for="pat-date">Preferred Date (Optional)</label>
                <input type="date" id="pat-date">
            </div>
            
            <button type="button" class="btn-submit" onclick="sendWhatsApp()">
                <i class="fab fa-whatsapp" style="font-size: 1.2rem;"></i> Continue to WhatsApp
            </button>
        </div>
    </div>

    <script>
        // 1. Preloader
        window.addEventListener('load', () => {
            setTimeout(() => {
                document.getElementById('preloader').style.opacity = '0';
                document.getElementById('preloader').style.visibility = 'hidden';
            }, 2500);
        });

        // 2. Navbar Scroll Effect
        const nav = document.getElementById('navbar');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
        });

        // 3. Mobile Menu Toggle
        const hamburger = document.getElementById('hamburger');
        const navLinks = document.getElementById('navLinks');
        const icon = hamburger.querySelector('i');

        hamburger.addEventListener('click', () => {
            navLinks.classList.toggle('active');
            if(navLinks.classList.contains('active')){
                icon.classList.remove('fa-bars');
                icon.classList.add('fa-times');
            } else {
                icon.classList.remove('fa-times');
                icon.classList.add('fa-bars');
            }
        });

        document.querySelectorAll('.nav-links a:not(.btn-book)').forEach(link => {
            link.addEventListener('click', () => {
                navLinks.classList.remove('active');
                icon.classList.remove('fa-times');
                icon.classList.add('fa-bars');
            });
        });

        // 4. Smooth Scroll Reveal
        const revealElements = document.querySelectorAll('.reveal');
        const revealOptions = { threshold: 0.15, rootMargin: "0px 0px -50px 0px" };
        const revealOnScroll = new IntersectionObserver(function(entries, observer) {
            entries.forEach(entry => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('active');
                observer.unobserve(entry.target); 
            });
        }, revealOptions);

        revealElements.forEach(el => revealOnScroll.observe(el));

        // 5. BULLETPROOF WHATSAPP ROUTING
        const modal = document.getElementById('bookingModal');

        function openModal() {
            modal.classList.add('active');
            navLinks.classList.remove('active');
            icon.classList.remove('fa-times');
            icon.classList.add('fa-bars');
        }

        function closeModal() {
            modal.classList.remove('active');
        }

        modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModal();
        });

        function sendWhatsApp() {
            const nameInput = document.getElementById('pat-name');
            const serviceInput = document.getElementById('pat-service');
            const dateInput = document.getElementById('pat-date');
            
            const name = nameInput.value.trim();
            const service = serviceInput.value;
            const date = dateInput.value;

            if (!name) {
                alert("Please enter your Full Name.");
                nameInput.focus();
                return;
            }
            if (!service) {
                alert("Please select a Service Needed.");
                serviceInput.focus();
                return;
            }

            const phone = "201557650318";
            
            const rawMessage = `Hello Dabah Dental Studio! 🦷\n\nMy name is *${name}*.\nI would like to book an appointment for: *${service}*.\n\nPreferred Date: ${date ? date : 'Flexible'}\n\nPlease let me know your availability.`;
            const encodedMessage = encodeURIComponent(rawMessage);

            const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
            let waUrl = "";

            if (isMobile) {
                waUrl = `whatsapp://send?phone=${phone}&text=${encodedMessage}`;
            } else {
                waUrl = `https://web.whatsapp.com/send?phone=${phone}&text=${encodedMessage}`;
            }

            const link = document.createElement('a');
            link.href = waUrl;
            if (!isMobile) link.target = '_blank'; 
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            
            nameInput.value = '';
            serviceInput.value = '';
            dateInput.value = '';
            closeModal();
        }
    </script>
